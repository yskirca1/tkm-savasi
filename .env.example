# ---- Game server ----
PORT=3001
# Public URL of the app (used for password-reset redirect links).
# Local: http://localhost:5173   Production: https://your-app.onrender.com
APP_URL=http://localhost:5173

# ---- Supabase (leave empty to run in local "dev mode" with in-memory users) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret! Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Set to false to hide the Google button (e.g. before the OAuth client is configured)
GOOGLE_ENABLED=true

# ---- Dev mode only ----
# Secret used to sign local JWTs when Supabase is not configured.
DEV_JWT_SECRET=change-me-local-only

# ---- Gameplay ----
# Units per species per round (4-20)
UNITS_PER_TYPE=12
